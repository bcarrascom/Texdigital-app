#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
op_to_pdf.py — Extrae la hoja "OP" o "OP TELAS" de un Excel y la exporta a PDF.

Cómo funciona (resumen):
  1. Busca dentro del Excel una hoja llamada "OP" o "OP TELAS".
  2. Crea una COPIA temporal del Excel donde TODAS las demás hojas quedan
     ocultas (sin reescribir el archivo con openpyxl, para no perder el logo
     ni el formato: se edita el .xlsx a nivel de ZIP).
  3. LibreOffice convierte esa copia a PDF. Como LibreOffice no exporta las
     hojas ocultas, el PDF contiene SOLO la hoja OP.
  4. Renombra el PDF y borra los temporales.

Requisitos:
  - LibreOffice instalado (el script intenta detectarlo solo).
  - openpyxl  (pip install openpyxl)  -> solo se usa para LEER nombres de hojas.
"""

import os
import re
import sys
import shutil
import zipfile
import tempfile
import subprocess
from pathlib import Path

# ──────────────────────────────────────────────────────────────────────────
#  CONFIGURACIÓN  (edita esto y nada más)
# ──────────────────────────────────────────────────────────────────────────

# Carpeta o archivo .xlsx de entrada. Puede ser:
#   - un archivo:  "C:/ruta/cotizacion.xlsx"
#   - una carpeta: procesa todos los .xlsx que haya dentro
ENTRADA = "./entrada"

# Carpeta donde se dejan los PDF generados.
SALIDA = "./salida"

# Nombres de hoja que se consideran "la hoja OP", en orden de prioridad.
# Si un Excel tiene varias, usa la primera que encuentre de esta lista.
NOMBRES_HOJA_OP = ["OP", "OP TELAS"]

# Ruta al ejecutable de LibreOffice (soffice).
# Déjalo en None para que el script lo busque automáticamente.
# Ejemplos si quieres forzarlo:
#   Windows: r"C:\Program Files\LibreOffice\program\soffice.exe"
#   Mac:     "/Applications/LibreOffice.app/Contents/MacOS/soffice"
RUTA_SOFFICE = None

# ──────────────────────────────────────────────────────────────────────────
#  A partir de aquí no necesitas tocar nada
# ──────────────────────────────────────────────────────────────────────────


def encontrar_soffice():
    """Devuelve la ruta al ejecutable de LibreOffice o None si no aparece."""
    if RUTA_SOFFICE:
        return RUTA_SOFFICE if Path(RUTA_SOFFICE).exists() else None

    # 1. ¿Está en el PATH?
    for nombre in ("soffice", "libreoffice"):
        ruta = shutil.which(nombre)
        if ruta:
            return ruta

    # 2. Rutas típicas por sistema operativo.
    candidatos = [
        # Windows
        r"C:\Program Files\LibreOffice\program\soffice.exe",
        r"C:\Program Files (x86)\LibreOffice\program\soffice.exe",
        # Mac
        "/Applications/LibreOffice.app/Contents/MacOS/soffice",
        # Linux
        "/usr/bin/soffice",
        "/usr/bin/libreoffice",
        "/opt/libreoffice/program/soffice",
    ]
    for c in candidatos:
        if Path(c).exists():
            return c
    return None


def nombre_hoja_op(xlsx_path):
    """
    Lee SOLO los nombres de las hojas (no toca contenido ni imágenes) y
    devuelve el nombre real de la hoja OP encontrada, o None.
    La comparación ignora mayúsculas/espacios sobrantes.
    """
    from openpyxl import load_workbook
    # read_only + no cargar datos: rápido y no modifica el archivo.
    wb = load_workbook(xlsx_path, read_only=True)
    hojas = wb.sheetnames
    wb.close()

    def norm(s):
        return re.sub(r"\s+", " ", s).strip().upper()

    objetivo = [norm(n) for n in NOMBRES_HOJA_OP]
    # Respetar la prioridad de NOMBRES_HOJA_OP.
    for buscado, original in zip(objetivo, NOMBRES_HOJA_OP):
        for h in hojas:
            if norm(h) == buscado:
                return h
    return None


def crear_copia_solo_op(xlsx_path, nombre_op, destino_xlsx):
    """
    Crea una copia del .xlsx en 'destino_xlsx' con todas las hojas ocultas
    excepto 'nombre_op'. Edita el ZIP directamente (preserva imágenes/formato).

    Devuelve True si lo logró, False si algo salió raro.
    """
    # Un .xlsx es un .zip. El orden y los nombres de las hojas están en
    # xl/workbook.xml, en elementos <sheet name="..." .../>.
    # Para ocultar una hoja se le agrega state="hidden".
    # Para que la hoja visible sea la activa, ajustamos activeTab.

    with zipfile.ZipFile(xlsx_path, "r") as zin:
        nombres_archivos = zin.namelist()
        if "xl/workbook.xml" not in nombres_archivos:
            return False
        workbook_xml = zin.read("xl/workbook.xml").decode("utf-8")

    # Localizar todos los <sheet .../> en orden.
    sheets = re.findall(r"<sheet\b[^>]*?/>", workbook_xml)
    if not sheets:
        return False

    indice_op = None
    nuevo_xml = workbook_xml
    for i, sheet_tag in enumerate(sheets):
        # Extraer el name="..." de la etiqueta.
        m = re.search(r'name="([^"]*)"', sheet_tag)
        nombre = m.group(1) if m else ""
        es_op = nombre.strip().upper() == nombre_op.strip().upper()

        if es_op:
            indice_op = i
            # Asegurar que la hoja OP esté visible: quitar cualquier state.
            tag_limpia = re.sub(r'\s+state="[^"]*"', "", sheet_tag)
            nuevo_xml = nuevo_xml.replace(sheet_tag, tag_limpia, 1)
        else:
            # Ocultar la hoja si no tiene ya un state; si lo tiene, forzar hidden.
            if "state=" in sheet_tag:
                tag_oculta = re.sub(r'state="[^"]*"', 'state="hidden"', sheet_tag)
            else:
                tag_oculta = sheet_tag[:-2] + ' state="hidden"/>'
            nuevo_xml = nuevo_xml.replace(sheet_tag, tag_oculta, 1)

    if indice_op is None:
        return False

    # Ajustar activeTab en <workbookView .../> para que abra en la hoja OP.
    if "<workbookView" in nuevo_xml:
        if re.search(r"<workbookView\b[^>]*activeTab=", nuevo_xml):
            nuevo_xml = re.sub(
                r'(<workbookView\b[^>]*?)\s*activeTab="[^"]*"',
                rf'\1 activeTab="{indice_op}"',
                nuevo_xml,
                count=1,
            )
        else:
            nuevo_xml = re.sub(
                r"(<workbookView\b)",
                rf'\1 activeTab="{indice_op}"',
                nuevo_xml,
                count=1,
            )

    # Reescribir el ZIP copiando todo igual, salvo workbook.xml.
    with zipfile.ZipFile(xlsx_path, "r") as zin:
        with zipfile.ZipFile(destino_xlsx, "w", zipfile.ZIP_DEFLATED) as zout:
            for item in zin.infolist():
                data = zin.read(item.filename)
                if item.filename == "xl/workbook.xml":
                    data = nuevo_xml.encode("utf-8")
                zout.writestr(item, data)
    return True


def convertir_a_pdf(soffice, xlsx_path, carpeta_salida):
    """Llama a LibreOffice headless para convertir un .xlsx a PDF."""
    # Cada conversión usa su propio perfil temporal para evitar el clásico
    # problema de "LibreOffice ya está abierto y el comando no hace nada".
    perfil = tempfile.mkdtemp(prefix="lo_profile_")
    try:
        cmd = [
            soffice,
            "--headless",
            "--norestore",
            f"-env:UserInstallation=file://{perfil}",
            "--convert-to", "pdf:calc_pdf_Export",
            "--outdir", str(carpeta_salida),
            str(xlsx_path),
        ]
        res = subprocess.run(
            cmd, capture_output=True, text=True, timeout=120
        )
        if res.returncode != 0:
            print("   LibreOffice error:", res.stderr.strip()[:300])
            return None
        # El PDF sale con el mismo nombre base que el xlsx temporal.
        pdf_generado = Path(carpeta_salida) / (Path(xlsx_path).stem + ".pdf")
        return pdf_generado if pdf_generado.exists() else None
    finally:
        shutil.rmtree(perfil, ignore_errors=True)


def procesar_excel(soffice, xlsx_path, carpeta_salida):
    """Procesa un solo Excel. Devuelve la ruta del PDF final o None."""
    xlsx_path = Path(xlsx_path)
    print(f"→ {xlsx_path.name}")

    nombre_op = nombre_hoja_op(xlsx_path)
    if not nombre_op:
        print(f"   ⚠ No tiene hoja {NOMBRES_HOJA_OP}. Se omite.")
        return None
    print(f"   Hoja OP encontrada: '{nombre_op}'")

    tmpdir = tempfile.mkdtemp(prefix="op_tmp_")
    try:
        temp_xlsx = Path(tmpdir) / (xlsx_path.stem + "_soloOP.xlsx")
        ok = crear_copia_solo_op(xlsx_path, nombre_op, temp_xlsx)
        if not ok:
            print("   ⚠ No se pudo aislar la hoja OP. Se omite.")
            return None

        pdf_temp = convertir_a_pdf(soffice, temp_xlsx, tmpdir)
        if not pdf_temp:
            print("   ⚠ LibreOffice no generó el PDF.")
            return None

        # Nombre final: mismo que el Excel original, con .pdf
        destino = Path(carpeta_salida) / (xlsx_path.stem + ".pdf")
        shutil.move(str(pdf_temp), str(destino))
        print(f"   ✓ PDF: {destino}")
        return destino
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def main():
    soffice = encontrar_soffice()
    if not soffice:
        print("ERROR: No se encontró LibreOffice.")
        print("Instálalo desde https://www.libreoffice.org/ o define RUTA_SOFFICE.")
        sys.exit(1)
    print(f"LibreOffice: {soffice}\n")

    entrada = Path(ENTRADA)
    salida = Path(SALIDA)
    salida.mkdir(parents=True, exist_ok=True)

    if entrada.is_file():
        archivos = [entrada]
    elif entrada.is_dir():
        archivos = sorted(entrada.glob("*.xlsx"))
    else:
        print(f"ERROR: La entrada '{ENTRADA}' no existe.")
        sys.exit(1)

    if not archivos:
        print(f"No hay archivos .xlsx en '{ENTRADA}'.")
        return

    ok = 0
    for f in archivos:
        if procesar_excel(soffice, f, salida):
            ok += 1
        print()

    print(f"Listo: {ok}/{len(archivos)} convertidos. PDFs en '{salida}'.")


if __name__ == "__main__":
    main()